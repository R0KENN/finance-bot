# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Где лежит база. Это единственный файл с данными — его достаточно копировать для бэкапа.
DB_PATH=data/finbot.db

# Часовой пояс по умолчанию для новых пользователей (каждый потом меняет свой в «Настройках»)
TIMEZONE=Europe/Moscow

# Пусто — бот открыт для всех. Иначе только эти Telegram id через запятую: 123456789,987654321
# Свой id можно узнать у @userinfobot
ALLOWED_USERS=

# Свой Telegram id (его покажет @userinfobot): каждые сутки бот пришлёт в личку копию базы,
# а на диске сервера копий не останется. Админ должен хотя бы раз написать боту /start.
# Команда /backup в любой момент присылает копию сразу. Пусто — копии не шлются.
ADMIN_ID=
# После какого часа (по TIMEZONE) слать копию
BACKUP_HOUR=4

# off — не пробовать «Статьи» (Rich Messages) и всегда слать статьи обычным текстом
RICH_MESSAGES=auto

LOG_LEVEL=INFO
